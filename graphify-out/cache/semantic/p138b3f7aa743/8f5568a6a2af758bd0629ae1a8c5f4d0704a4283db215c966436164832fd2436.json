{"nodes": [{"id": "docs_guest_guide", "label": "reFLOP Guest Guide", "file_type": "document", "source_file": "docs/GUEST_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_reflop_pair", "label": "reflop pair (Guest pairing)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Invite is one-time and expires (24h default); pairing creates an Ed25519 key and pins the server key."}, {"id": "docs_guest_guide_server_key_pinning", "label": "Server Key Pinning", "file_type": "rationale", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the server ever presents a different key the client stops before sending anything, preventing server impersonation."}, {"id": "docs_guest_guide_ssh_host_key_pinning", "label": "SSH Host Key Pinning", "file_type": "rationale", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client keeps its own known_hosts and runs ssh with StrictHostKeyChecking=yes so any other host key is refused regardless of ~/.ssh/config."}, {"id": "docs_guest_guide_reflop_client_home", "label": "REFLOP_CLIENT_HOME", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L56", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets one machine act as several Guests with separate config and keys."}, {"id": "docs_guest_guide_reflop_unpair", "label": "reflop unpair", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_reflop_device", "label": "reflop.device()", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_reflop_seed", "label": "reflop.seed()", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeds all open sessions and the initial seed of later sessions."}, {"id": "docs_guest_guide_lazy_graph_recording", "label": "Lazy Graph Recording and Flush", "file_type": "rationale", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operations are recorded, not executed, and sent as one graph when a value must leave the server; execution is asynchronous so the client records step N+1 while the server runs step N."}, {"id": "docs_guest_guide_step_boundary", "label": "reflop.step_boundary()", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps one graph per step so identical steps reuse the cached graph."}, {"id": "docs_guest_guide_graph_hash_caching", "label": "Graph Hash Caching", "file_type": "rationale", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identical steps produce identical graphs, so only the hash and inputs are sent; Python floats are sent as inputs to avoid new graphs each step."}, {"id": "docs_guest_guide_sessions", "label": "Sessions (server worker process)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L132", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_session_ttl", "label": "Session TTL ([session] ttl)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disconnected sessions are kept 30 minutes by default so the client can reconnect, but give up GPU memory when a new session needs it."}, {"id": "docs_guest_guide_reflop_usage", "label": "reflop usage", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L142", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_async_error_semantics", "label": "Asynchronous Error Semantics (no stale reads)", "file_type": "rationale", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server answers in order so by the time a value arrives every earlier failure is known; a value is never returned while a failure is pending; failed requests change nothing."}, {"id": "docs_guest_guide_outofmemoryerror", "label": "reflop.OutOfMemoryError", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L168", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subclass of torch.OutOfMemoryError so batch-shrinking code works unchanged."}, {"id": "docs_guest_guide_sessionlosterror", "label": "reflop.SessionLostError", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_datasets", "label": "reFLOP Datasets", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L205", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decode and preprocess on the client, upload once; each step sends only 8-byte batch indices; pushes are resumable in verified 4 MiB chunks."}, {"id": "docs_guest_guide_reflop_capture", "label": "reflop.capture", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L246", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removes per-operation client cost (20-30 us/op) by replaying a checked graph after two eager warm-up calls; does not make uploads faster."}, {"id": "docs_guest_guide_captureerror", "label": "reflop.CaptureError", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L282", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raised instead of silently freezing a Python value that changes every step."}, {"id": "docs_guest_guide_torch_compile_unsupported", "label": "torch.compile Unsupported", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L308", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TorchDynamo cannot trace reFLOP's tensor subclass; reflop.capture gives the same benefit."}, {"id": "docs_guest_guide_throughput_benchmark", "label": "Throughput Benchmark (21 Nov 2026 run)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L311", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resident data with capture kept 16-90% of native CUDA speed; LSTM/GRU 2.5-4% due to per-timestep graphs; uploads network-bound."}, {"id": "docs_guest_guide_reflop_run", "label": "reflop run (CUDA shim)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L339", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-effort mapping of cuda calls to the reFLOP device for unmodified scripts."}, {"id": "docs_guest_guide_omp_threads_workaround", "label": "OMP_NUM_THREADS=1 macOS Workaround", "file_type": "rationale", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L357", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two OpenMP runtimes in one process crash or hang on macOS (#7); one thread avoids it with little cost since math runs on the server."}, {"id": "docs_guest_guide_placement", "label": "reflop.placement (auto/remote/local/remote-cpu)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L369", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_placement_cost_model", "label": "Placement Cost Model", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L380", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses CPU speed, server speed, bandwidth and RTT measured by reflop init to decide local vs remote execution."}, {"id": "docs_guest_guide_write_back_semantics", "label": "Local Write-back Semantics for reFLOP Tensors", "file_type": "rationale", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L386", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-place ops, out= and views of reFLOP tensors behave as in PyTorch even when run locally; fixed silent lost writes from 0.2.5 and earlier."}, {"id": "docs_guest_guide_server_cpu_device", "label": "Server CPU Device", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L406", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_reflop_fetch", "label": "reflop.fetch (local safetensors checkpoint)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L433", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "reFLOP tensors refuse pickling, so torch.save raises; files are always safetensors."}, {"id": "docs_guest_guide_snapshots", "label": "Server Snapshots (reflop.save/load)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L444", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_automatic_checkpoints", "label": "Automatic Checkpoints (Guest)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L460", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checkpoints at step boundaries; GPU memory for state doubles during a checkpoint, skipped if not free."}, {"id": "docs_guest_guide_reflop_recover", "label": "reflop.recover()", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L486", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_checkpoint_tag", "label": "reflop.checkpoint_tag()", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L497", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_paused_request_limit", "label": "Paused Request Hold Limit (4096 per session)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L525", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_mixed_precision", "label": "Mixed Precision (autocast, GradScaler)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L531", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_unsupported_features", "label": "Unsupported Features (custom kernels, sparse, multi-GPU)", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L545", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_reflop_debug", "label": "REFLOP_DEBUG", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L574", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_reflop_doctor", "label": "reflop doctor", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L565", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_reflop_update", "label": "reflop update", "file_type": "concept", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L611", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guest_guide_privacy_model", "label": "Guest Privacy Model", "file_type": "rationale", "source_file": "docs/GUEST_GUIDE.md", "source_location": "L617", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "reFLOP protects the Owner's machine from Guests, not Guests' data from the Owner; the server sees data and models in plaintext."}], "edges": [{"source": "docs_guest_guide", "target": "docs_guest_guide_reflop_pair", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUEST_GUIDE.md", "source_location": "L23", "weight": 1.0}, {"source": "docs_guest_guide", "target": "docs_guest_guide_server_key_pinning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUEST_GUIDE.md", "source_location": "L53", "weight": 1.0}, {"source": "docs_guest_guide", "target": "docs_guest_guide_ssh_host_key_pinning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUEST_GUIDE.md", "source_location": "L63", "weight": 1.0}, {"source": "docs_guest_guide", "target": "docs_guest_guide_reflop_client_home", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/GUEST_GUIDE.md", "source_location": "L56", "weight": 1.0}, {"source": "docs_guest_guide", "target": "docs_guest_guide_reflop_unpai