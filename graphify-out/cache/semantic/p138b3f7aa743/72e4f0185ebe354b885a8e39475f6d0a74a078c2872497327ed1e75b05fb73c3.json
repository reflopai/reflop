{"nodes": [{"id": "benchmark_report_figures_throughput_b128_throughput_chart", "label": "Throughput at Batch 128 Chart (log-scale grouped bars)", "file_type": "image", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grouped bar chart of training samples/second (log scale) for 10 models across 4 execution modes at batch 128. Title claim: keeping inputs on the GPU dominates throughput. Capture/resident is highest for every model (~1e4 to ~1.6e5 samples/s); upload modes fall 1-3 orders of magnitude lower (e.g. U-Net ~65-120, ResNet-18 ~200, CNN ~450-650 samples/s)."}, {"id": "benchmark_report_figures_throughput_b128_gpu_residency_dominates", "label": "Keeping inputs on GPU dominates throughput", "file_type": "concept", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resident-input modes beat upload modes for every model; host-to-device upload cost overwhelms compute, especially for conv models (CNN, ResNet-18, U-Net). Gap is smallest for LSTM/GRU/GPT where compute dominates."}, {"id": "benchmark_report_figures_throughput_b128_eager_resident", "label": "Eager / resident mode", "file_type": "concept", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_throughput_b128_capture_resident", "label": "Capture / resident mode", "file_type": "concept", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fastest configuration for all models; capture (graph replay) gives roughly 2-5x over eager when inputs are resident."}, {"id": "benchmark_report_figures_throughput_b128_eager_upload", "label": "Eager / upload mode", "file_type": "concept", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_throughput_b128_capture_upload", "label": "Capture / upload mode", "file_type": "concept", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture provides little or no benefit when inputs must be uploaded each step; sometimes slower than eager/upload (MLP, CNN, Autoencoder), sometimes faster (GRU, U-Net)."}, {"id": "benchmark_report_figures_throughput_b128_model_suite", "label": "Benchmark model suite (MLP, CNN, ResNet-18, U-Net, LSTM, GRU, Attention, GPT, LoRA-style, Autoencoder)", "file_type": "concept", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_throughput_b128_resnet18_correctness_unresolved", "label": "ResNet-18 correctness unresolved", "file_type": "concept", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ResNet-18 is marked with an asterisk: correctness unresolved, so its throughput numbers are provisional."}, {"id": "benchmark_report_figures_throughput_b128_rate_metric", "label": "Rate = batch / mean synchronized seconds per step", "file_type": "concept", "source_file": "benchmark/report/figures/throughput-b128.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throughput metric; whiskers span 3 repeat rates."}, {"id": "benchmark_report_figures_throughput_b128_run_20261114t042619z", "l