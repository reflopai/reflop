{"nodes": [{"id": "benchmark_report_figures_batch_scaling_figure", "label": "Batch Scaling Figure (batch-scaling.svg)", "file_type": "image", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L1-6853", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Matplotlib 3.11.2 figure, a 2x5 grid of log-log line charts. Each panel is a workload. X is batch size (1, 8, 32, 128) and Y is samples/second, with each panel on its own y range. It plots 4 execution-mode series. Title: 'Batch scaling varies by workload and input residency'."}, {"id": "benchmark_report_figures_batch_scaling_title_insight", "label": "Batch scaling varies by workload and input residency", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L6030-6178", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Headline finding. Throughput with resident inputs keeps rising roughly linearly with batch size. Throughput with per-step host upload flattens or drops at large batches, so the gap widens with batch (e.g. Autoencoder at batch 128 is ~1.6e5 samples/s for capture/resident vs ~2e3 for capture/upload)."}, {"id": "benchmark_report_figures_batch_scaling_capture_resident_best", "label": "Capture/resident is fastest at batch 128 in every panel", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L888-913, L1454-1466, L1898-1908, L2708-2720, L3208-3220, L3779-3791, L4334-4346, L4879-4891, L5393-5405, L5940-5952", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "In all 10 panels the green Capture/resident series reaches the top of the plot at batch 128. Approximate peaks read off the plots: MLP ~1.1e5, CNN ~9e4, ResNet-18 ~2e4, U-Net ~5e4, LSTM ~1.1e4, GRU ~1.2e4, Attention ~6.6e4, GPT ~6.3e4, LoRA-style ~1.5e5, Autoencoder ~1.6e5 samples/s."}, {"id": "benchmark_report_figures_batch_scaling_upload_plateau", "label": "Upload-mode throughput plateaus with batch size", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L914-965, L1467-1492, L1909-1930, L2721-2746, L4347-4372, L5406-5431, L5953-5978", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "The dashed Eager/upload and Capture/upload series stay flat or fall at batch 32-128 in most panels (MLP, CNN, ResNet-18, U-Net, Attention, LoRA-style, Autoencoder). LSTM is the exception: there, upload throughput keeps scaling close to the resident throughput."}, {"id": "benchmark_report_figures_batch_scaling_samples_per_second", "label": "Samples / second (y-axis metric)", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L560-860", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_batch_scaling_batch_size", "label": "Batch size (x-axis: 1, 8, 32, 128)", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L3300-3513", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_batch_scaling_eager_resident", "label": "Eager / resident series", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L6682-6728", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Blue solid line (#3176ae). Eager execution with inputs already resident on the device."}, {"id": "benchmark_report_figures_batch_scaling_capture_resident", "label": "Capture / resident series", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L6729-6760", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Green solid line (#159580). Captured (graph-replay) execution with device-resident inputs."}, {"id": "benchmark_report_figures_batch_scaling_eager_upload", "label": "Eager / upload series", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L6761-6788", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Orange dashed line (#d28d27). Eager execution with inputs uploaded each step."}, {"id": "benchmark_report_figures_batch_scaling_capture_upload", "label": "Capture / upload series", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L6789-6818", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Pink dashed line (#b66086). Captured execution with inputs uploaded each step."}, {"id": "benchmark_report_figures_batch_scaling_input_residency", "label": "Input residency (resident vs upload)", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L6030-6178", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_batch_scaling_execution_mode", "label": "Execution mode (eager vs capture)", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L6668-6819", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_batch_scaling_mlp", "label": "MLP workload panel", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L976-1031", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_batch_scaling_cnn", "label": "CNN workload panel", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.svg", "source_location": "L1503-1546", "source_url": null, "capture