{"nodes": [{"id": "benchmark_report_figures_batch_scaling_batch_scaling_chart", "label": "Batch Scaling Chart (Samples/sec vs Batch Size)", "file_type": "image", "source_file": "benchmark/report/figures/batch-scaling.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_batch_scaling_batch_scaling_varies_by_workload_and_residency", "label": "Finding: Batch scaling varies by workload and input residency", "file_type": "rationale", "source_file": "benchmark/report/figures/batch-scaling.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture/resident scales near-linearly to ~1e5 samples/s at batch 128 on most workloads and is consistently the fastest; eager/resident scales similarly but lower. Upload modes (eager and capture) plateau or regress at larger batches for CNN, ResNet-18, U-Net, Attention, LoRA-style and Autoencoder, indicating host-to-device input transfer becomes the bottleneck. Recurrent models (LSTM, GRU) and GPT keep scaling even with upload."}, {"id": "benchmark_report_figures_batch_scaling_eager_resident", "label": "Eager / resident mode", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_batch_scaling_capture_resident", "label": "Capture / resident mode", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benchmark_report_figures_batch_scaling_eager_upload", "label": "Eager / upload mode", "file_type": "concept", "source_file": "benchmark/report/figures/batch-scaling.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"i