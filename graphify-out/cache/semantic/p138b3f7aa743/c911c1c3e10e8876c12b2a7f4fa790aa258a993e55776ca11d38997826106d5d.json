{"nodes": [{"id": "docs_owner_guide", "label": "reFLOP Owner Guide", "file_type": "document", "source_file": "docs/OWNER_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_requirements", "label": "Owner Requirements (Linux, NVIDIA driver, Landlock/seccomp)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_reflopd_up", "label": "reflopd up", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_runtime_variants", "label": "Pinned Runtimes (cu132, cu126, cpu)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runtime is downloaded and verified against SHA-256 sums compiled into reflopd; Guests cannot trigger, choose or change it."}, {"id": "docs_owner_guide_self_test", "label": "reflopd Self-test", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L55", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A GPU with no free memory is skipped and rechecked every 30 seconds instead of blocking startup."}, {"id": "docs_owner_guide_systemd_user_service", "label": "reflopd systemd User Service (Delegate=yes)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Delegate=yes gives each worker its own cgroup for memory and process rails."}, {"id": "docs_owner_guide_reflopd_invite", "label": "reflopd invite (one-time invite code)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed attempt also consumes the invite so a leaked code cannot be brute-forced."}, {"id": "docs_owner_guide_reflopd_revoke", "label": "reflopd revoke / users delete", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_reflopd_unpair", "label": "reflopd unpair", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_network_exposure", "label": "Network Exposure and Binding", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tailscale/WireGuard binding recommended; authentication required on every bind; TLS 1.3."}, {"id": "docs_owner_guide_ssh_pipe_mode", "label": "SSH Pipe Mode (forced-command reflopd serve --stdio)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses sshd without opening a port; restrict line forbids shell, PTY and forwarding."}, {"id": "docs_owner_guide_level1_system_install", "label": "Level 1 System Install", "file_type": "rationale", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves reflopd into a dedicated 'reflop' account with a hardened systemd unit so a sandbox escape does not land in the Owner's account."}, {"id": "docs_owner_guide_safety_rails", "label": "Safety Rails (disk, RAM, pids, protocol limits, feasibility)", "file_type": "rationale", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L188", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always on and cannot be turned off; minimums enforced; they keep the machine alive."}, {"id": "docs_owner_guide_host_ram_floor", "label": "Host RAM Floor with Per-worker Memory Limit", "file_type": "rationale", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L196", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each worker gets its own limit (usage + 7/8 of free), so the growing worker is killed rather than another Guest's larger one."}, {"id": "docs_owner_guide_quotas", "label": "Quotas (device memory, sessions, storage, bandwidth)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L212", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fairness only, none by default; 0 rejected because unset means unlimited."}, {"id": "docs_owner_guide_session_eviction", "label": "Session Eviction (session_evicted)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L215", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Oldest disconnected session on a GPU is ended when a new session or a running allocation lacks memory; a graph rejected as too big never ends another session."}, {"id": "docs_owner_guide_owner_controls", "label": "Owner Controls (pause, resume, kill, say)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L235", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Events shown to Guests are informational only."}, {"id": "docs_owner_guide_pause_now_suspend", "label": "reflopd pause --now GPU Suspend (ADR-030)", "file_type": "rationale", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L251", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Driver moves GPU worker memory into host RAM so the Owner gets the GPU back without ending sessions."}, {"id": "docs_owner_guide_auto_yield", "label": "reflopd yield --auto", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L243", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_guest_checkpoints", "label": "Guest Checkpoints (Owner control)", "file_type": "rationale", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Off by default; wear SSDs and double GPU memory during copy; interval never below 5 minutes; skipped rather than forced."}, {"id": "docs_owner_guide_audit_log", "label": "Audit Log", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L333", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records connections, pairing, graph registrations, executes, rejections and kills, never tensor contents; kept 30 days."}, {"id": "docs_owner_guide_reflopd_usage", "label": "reflopd usage (device time per Guest)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L347", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Device time is the main measure since it is measured and charges memory-bound work fairly; FLOP estimate undercounts memory-bound work."}, {"id": "docs_owner_guide_files_directories", "label": "reflopd Files and Directories", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L380", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_reflopd_toml", "label": "reflopd.toml Configuration", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L396", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unknown keys rejected."}, {"id": "docs_owner_guide_reflopd_update", "label": "reflopd update (signed releases)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L437", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_benchmark_guide", "label": "GPU Benchmarking (15 Nov 2026 comparison)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L452", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_reflopd_doctor", "label": "reflopd doctor", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L478", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_owner_guide_worker_sandbox", "label": "Worker Sandbox (Landlock, seccomp, namespaces, cgroups)", "file_type": "concept", "source_file": "docs/OWNER_GUIDE.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_owner_guide", "target": "docs_owner_guide_requirements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/OWNER_GUIDE.md", "source_location": "L23", "weight": 1.0}, {"source": "docs_owner_guide", "target": "docs_owner_guide_reflopd_up", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/OWNER_GUIDE.md", "source_location": "L47", "weight": 1.0}, {"source": "docs_owner_guide", "target": "docs_owner_guide_runtime_variants", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/OWNER_GUIDE.md", "source_location": "L49", "weight": 1.0}, {"source": "docs_owner_guide", "target": "docs_owner_guide_self_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/OWNE