{"nodes": [{"id": "docs_decisions", "label": "reFLOP Design Decisions (ADRs)", "file_type": "document", "source_file": "docs/DECISIONS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_adr_001", "label": "ADR-001: FlopIR as the wire format", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TorchScript/FX pickles are code (rejected by I1); StableHLO gives no PyTorch-native kernel mapping. Loop-free DAG makes validation linear and allows a later StableHLO frontend."}, {"id": "docs_decisions_adr_002", "label": "ADR-002: Capture strategy (lazy dispatch + reflop.capture)", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deviation: TorchDynamo cannot fake-ify RemoteTensor (no inner tensor), so torch.compile backend replaced by static capture-and-replay verified over two eager calls."}, {"id": "docs_decisions_adr_003", "label": "ADR-003: Opset v1 adjustments", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each opset entry is one fully qualified overload, making overload_id redundant; mutating _foreach out overloads dropped because the wire is functional."}, {"id": "docs_decisions_adr_004", "label": "ADR-004: Sandbox implementation", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Landlock before exec covers every thread on every ABI (pre-ABI-8 Landlock restricts only the calling thread); seccomp after warm-up with TSYNC; data passed as fds; all new sockets denied."}, {"id": "docs_decisions_adr_005", "label": "ADR-005: Framed protobuf instead of gRPC", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L156", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deviation: grpcio cannot run over an arbitrary byte stream like an ssh subprocess, and HTTP/2 adds attack surface; one protocol implementation for both transports."}, {"id": "docs_decisions_adr_006", "label": "ADR-006: Authentication and pairing", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SPAKE2 only helps low-entropy passwords; invite secret is 256 random bits over an already pinned channel. mTLS rejected because Python ssl cannot verify against an app key store without a CA."}, {"id": "docs_decisions_adr_007", "label": "ADR-007: Reuse of recom code", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L195", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Author confirmed sole authorship of recom, allowing relicensing under Apache-2.0."}, {"id": "docs_decisions_adr_008", "label": "ADR-008: The pinned runtime", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L207", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner should not install Python packages (G4) and Guests must never influence what is installed; triton excluded since the worker never compiles kernels."}, {"id": "docs_decisions_adr_009", "label": "ADR-009: Safety rail defaults", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L236", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner confirmed disk floor max(10%, 20 GiB), host RAM floor 4 GiB, 4096 processes per worker."}, {"id": "docs_decisions_adr_010", "label": "ADR-010: Distribution and updates", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L246", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One install.sh for client and --server; auto-detecting role would surprise on Linux laptops with GPUs."}, {"id": "docs_decisions_adr_011", "label": "ADR-011: Node argument encoding", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L264", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deviation: positional, fully explicit args so equal programs give byte-identical graphs; lifted scalars keep the graph hash stable."}, {"id": "docs_decisions_adr_012", "label": "ADR-012: Data-dependent shapes (two-phase DDS)", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L280", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server only ever executes static shapes; costs two round trips per data-dependent op."}, {"id": "docs_decisions_adr_013", "label": "ADR-013: No MemoryDenyWriteExecute on Level 1 unit", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L293", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deviation: systemd implements it as an inherited seccomp filter, and CUDA/PyTorch workers need W+X mappings."}, {"id": "docs_decisions_adr_014", "label": "ADR-014: Performance without weakening checks", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L304", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meta cache, capture, flat plans and proven immutable-tensor index ranges reach 74% throughput while bounds checks (I4) still run before every IDX kernel (R7)."}, {"id": "docs_decisions_adr_015", "label": "ADR-015: One autograd-visible device (reflop:0)", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L326", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PyTorch's Python-backend device guard reports one device and autograd asserts on higher indices."}, {"id": "docs_decisions_adr_016", "label": "ADR-016: cgroups only in reflopd-owned units", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L339", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shell's own scope holds other processes; enabling controllers there fails and would affect the terminal."}, {"id": "docs_decisions_adr_017", "label": "ADR-017: libreflop in Go (c-shared)", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L352", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A C implementation would need its own protobuf encoder, strict decoder, TLS pinning and key parsing in a memory-unsafe language."}, {"id": "docs_decisions_adr_018", "label": "ADR-018: reflopd sandboxes itself by re-exec", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L367", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Go programs are multi-threaded from start, so Landlock+seccomp applied on a locked thread then re-exec."}, {"id": "docs_decisions_adr_019", "label": "ADR-019: File-backed state with change detection", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L381", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Owner commands are separate processes; daemon reloads the 0600 JSON on mtime/size change."}, {"id": "docs_decisions_adr_020", "label": "ADR-020: OOM messages are trimmed", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L390", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PyTorch's OOM message lists other GPU processes, leaking other tenants to a Guest."}, {"id": "docs_decisions_adr_021", "label": "ADR-021: The client on PyPI, uploaded from the signed release", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L398", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guests needed a second install to import reflop; uploading the same signed bytes via Trusted Publishing avoids a PyPI token and divergent files."}, {"id": "docs_decisions_adr_022", "label": "ADR-022: Only an OOM while running ends a detached session", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L428", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An oversized graph rejected at validation would let any Guest evict all detached sessions at no cost; only OOM at E1-E3 evicts."}, {"id": "docs_decisions_adr_023", "label": "ADR-023: A full GPU at startup is served once a probe succeeds", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L455", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A GPU full at startup (e.g. leaking gnome-shell) must not stop reflopd entirely; serving unprobed GPUs with default op table would fail open."}, {"id": "docs_decisions_adr_024", "label": "ADR-024: Deleting a revoked identity", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L486", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "revoke --delete rejected because one typo could delete an active Guest's data; audit log stays append-only."}, {"id": "docs_decisions_adr_025", "label": "ADR-025: Unpairing on both sides", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L511", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guest half (Unpair message revokes own identity only) and Owner half (reflopd unpair = revoke + users delete), either order."}, {"id": "docs_decisions_adr_026", "label": "ADR-026: Showing ssh's stderr in connection errors", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L563", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep last 8 lines x 300 bytes, sanitized, display only; parsing untrusted text rejected."}, {"id": "docs_decisions_adr_027", "label": "ADR-027: reflop run keeps OpenMP on one thread on macOS", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L601", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two OpenMP runtimes in one process fight once both start pools; KMP_DUPLICATE_LIB_OK is unsafe; changing threading at import is surprising."}, {"id": "docs_decisions_adr_028", "label": "ADR-028: Snapshots written durably and restored all or nothing", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L648", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-phase write (SnapshotCut/SnapshotGo) reserves exact size against disk rail and quota; restore validates everything before committing all handles."}, {"id": "docs_decisions_adr_029", "label": "ADR-029: Guest checkpoints: Owner opt-in, 5-minute floor, no redo log", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L692", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real cost of checkpoints is disk writes (72 GiB/hour worst case), so Owner opt-in with a hard floor; redo log deferred until deterministic numerics are strict."}, {"id": "docs_decisions_adr_030", "label": "ADR-030: pause --now suspends GPU workers", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L751", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CUDA driver checkpoint API frees the GPU in under a second without ending sessions; helper accepts only reflop workers since it can freeze processes."}, {"id": "docs_decisions_adr_031", "label": "ADR-031: Isolation probes run in CI and fail closed", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L795", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A skipping job would go green after a runner kernel change; strict mode fails instead of skipping and runs with user namespaces off and on."}, {"id": "docs_decisions_adr_032", "label": "ADR-032: Worker meta kernel for _ctc_loss_backward with exact input shapes", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L834", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PyTorch has no meta kernel for it and its backward kernel trusts input shapes (crash or OOB read), so exact shapes are checked at validation."}, {"id": "docs_decisions_adr_033", "label": "ADR-033: A read never returns data while an earlier failure is pending", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L879", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relies on in-order answers per session; sequence numbers or synchronous executes would cost a protocol change or throughput."}, {"id": "docs_decisions_adr_034", "label": "ADR-034: Placement never runs a writing or aliasing op on copies", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L920", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running in-place/out=/view ops on fetched copies silently lost updates (optimizer step under local placement)."}, {"id": "docs_decisions_adr_035", "label": "ADR-035: Each worker gets its own memory limit below the shared one", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L957", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With only a shared memory.max the kernel killed the largest worker, not the grower; a 1/8-headroom margin makes the per-worker limit fail first."}, {"id": "docs_decisions_adr_036", "label": "ADR-036: Keep the explicit default and seed every session", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L1006", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Implicit CPU sessions from placement must not become the default; reflop.seed reseeds all sessions."}, {"id": "docs_decisions_adr_037", "label": "ADR-037: Fetch large execute results in chunks", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L1026", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inline result budget of one quarter of the frame limit; raising frame size would increase per-response memory and still leave a cutoff."}, {"id": "docs_decisions_adr_038", "label": "ADR-038: Keep implicit CPU placement with the selected Owner", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L1049", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuse a CPU session only when pinned fingerprint and Guest id match, so CPU work is never sent to another paired Owner."}, {"id": "docs_decisions_reflop_capture", "label": "reflop.capture (static capture and replay)", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L69", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_sandbox_exec", "label": "reflopd __sandbox-exec", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_proven_index_ranges", "label": "Proven Index Value Ranges", "file_type": "rationale", "source_file": "docs/DECISIONS.md", "source_location": "L317", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server tensors are immutable, so a known value range stays valid; only unknown ranges need a device sync."}, {"id": "docs_decisions_meta_inference_cache", "label": "Client Meta Inference Cache", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L312", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_unpair_message", "label": "Unpair / Unpaired protocol messages", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L524", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_snapshot_two_phase_write", "label": "Two-phase Snapshot Write (SnapshotCut / SnapshotGo)", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L660", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_reflop_save_load", "label": "reflop.save / reflop.load / snapshots API", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L675", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_reflop_recover", "label": "reflop.recover() / RecoverSession", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L719", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_cuda_checkpoint_api", "label": "CUDA Driver Process Checkpoint API (cuCheckpointProcess*)", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L755", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_suspend_helper", "label": "Suspend Helper (embedded Python script)", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L764", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_isolation_workflow", "label": "Isolation CI Workflow (isolation.yml, REFLOP_TEST_STRICT)", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L805", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_meta_overrides", "label": "meta.OVERRIDES (worker-supplied meta kernels)", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L848", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_per_worker_memory_max", "label": "Per-worker memory.max below shared limit", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L969", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_pinned_runtime_variants", "label": "Pinned Runtime Variants (cu132, cu126, cpu)", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L218", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_pypi_trusted_publishing", "label": "PyPI Trusted Publishing (pypi.yml)", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L409", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_decisions_detached_session_eviction", "label": "Detached Session Eviction on OOM", "file_type": "concept", "source_file": "docs/DECISIONS.md", "source_location": "L432", "source_url": null, "captured_at": null, "author": null, "contributor": nu