{"nodes": [{"id": "benchmark_report_figures_native_cuda_comparison_figure", "label": "Native CUDA Comparison Figure", "file_type": "image", "source_file": "benchmark/report/figures/native-cuda-comparison.svg", "source_location": "L1-L4576", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Matplotlib 3.11.2 figure (2026-11-16): 2x2 grid of annotated heatmaps, suptitle 'reFLOP throughput relative to native PyTorch on the same GPU', subtitle '100% = equal throughput; N/A = missing or nonpassing case'. Rows: 10 workloads; columns: batch size 1/8/32/128; color = % of native eager CUDA throughput (0-100 colorbar)."}, {"id": "benchmark_report_figures_native_cuda_comparison_eager_resident_heatmap", "label": "reFLOP eager / resident heatmap", "file_type": "image", "source_file": "benchmark/report/figures/native-cuda-comparison.svg", "source_location": "L31-L1595", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Values 0.8%-21.7%. Best: resnet18 21.7% @bs128, 18.2% @bs32; unet 16.3%; cnn 13.6%; mlp 8.5-13.1%; lstm/gru ~0.8-1.0%; transformer 6.6-6.9%; gpt 6.5-7.9%; lora 9.4-11.8%; autoencoder 8.2-8.9%. resnet18 bs1 N/A."}, {"id": "benchmark_report_figures_native_cuda_comparison_capture_resident_heatmap", "label": "reFLOP capture / resident heatmap", "file_type": "image", "source_file": "benchmark/report/figures/native-cuda-comparison.svg", "source_location": "L1595-L2297", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Values 4.0%-70.1%. resnet18 53.8/63.8/70.1% (bs8/32/128); mlp 37.1-55.3%; cnn 43.5-46.6%; unet 38.3-49.8%; lora 40.6-45.1%; gpt 35.6-42.9%; autoencoder 36.3-37.2%; transformer 31.6-36.0%; lstm/gru 4.0-5.3%. resnet18 bs1 N/A.", "rationale": "Capture mode lifts throughput roughly 4-5x over eager in the resident setting; recurrent models (lstm, gru) stay near 5% in every configuration."}, {"id": "benchmark_report_figures_native_cuda_comparison_eager_upload_heatmap", "label": "reFLOP eager / upload heatmap", "file_type": "image", "source_file": "benchmark/report/figures/native-cuda-comparison.svg", "source_location": "L2297-L2971", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Values 0.3%-13.7%, generally decreasing with batch size: mlp 12.6->2.1%, cnn 10.6->0.4%, unet 11.7->0.3%, resnet18 13.7->2.9%, autoencoder 9.5->1.0%; lstm/gru ~0.9-1.1%; gpt flat ~6.6-7.7%. resnet18 bs1 N/A."}, {"id": "benchmark_report_figures_native_cuda_comparison_capture_upload_heatmap", "label": "reFLOP capture / upload heatmap", "file_type": "image", "source_file": "benchmark/report/figures/native-cuda-comparison.svg", "source_location": "L2971-L3655", "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Values 0.3%-49.7%, strongly decreasing with batch size: mlp 49.7->2.1%, cnn 24.4->0.4%, transformer 37.4->2.6%, autoencoder 37.7->1.0%, lora 36.0->2.2%, gpt 34.9->10.5%; lstm/gru 3.9-5.6%. resnet18 bs1 N/A.", "rationale": "With per-call input upload, capture helps at small batch but data transfer dominates at large batch, collapsing relative throughput to ~0-3% at bs128."}, {"id": "benchmark_report_figures_native_cuda_comparison_relative_throughput_metric", "label": "% of native eager CUDA throughput", "file_type": "concept", "source_file": "benchmark/report/figures/native-cuda-comparison.svg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Colorbar metric (0-100) shared by all four panels; 100% means reFLOP equals native PyTorch eager CUDA throughput on the same GPU."}, {"id": "benchmark_report_figures_native_cuda_comparison_native_pytorch_eager_cuda_baseline", "label": "Native PyTorch eager CUDA baseline", "file_type": "concept", "source_file": "benchmark/report/figures/native-cuda-comparison.svg", "source_location": null, "source_url": null, "captured_a